{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
  ],
  dependencyDashboard: false,
  timezone: 'UTC',
  schedule: ['before 6am'],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  branchConcurrentLimit: 0,
  labels: ['dependencies'],
  postUpdateOptions: ['gomodTidy'],
  lockFileMaintenance: {
    enabled: true,
  },
  // Security PRs run outside the weekly window, labelled for triage.
  vulnerabilityAlerts: {
    labels: ['security'],
    schedule: [],
  },
  // Tracks CI tool versions pinned as env vars or action inputs, annotated
  // above each with a Renovate datasource/depName comment.
  customManagers: [
    {
      customType: 'regex',
      fileMatch: ['^\\.github/workflows/.+\\.ya?ml$'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*[\\w-]+:\\s*[\'"]?(?<currentValue>[^\'"\\s]+)',
      ],
    },
  ],
  packageRules: [
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      matchManagers: ['github-actions'],
      pinDigests: true,
      automerge: true,
    },
    {
      matchManagers: ['custom.regex'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
  ],
}

{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':semanticCommits',
  ],
  dependencyDashboard: false,
  timezone: 'UTC',
  schedule: ['before 6am'],
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  branchConcurrentLimit: 0,
  labels: ['dependencies'],
  postUpdateOptions: ['gomodTidy'],
  lockFileMaintenance: {
    enabled: true,
  },
  // Security PRs run outside the weekly window, labelled for triage.
  vulnerabilityAlerts: {
    labels: ['security'],
    schedule: [],
  },
  packageRules: [
    {
      matchManagers: ['gomod'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
    {
      matchManagers: ['github-actions'],
      pinDigests: true,
      automerge: true,
    },
    {
      matchUpdateTypes: ['major'],
      automerge: false,
    },
  ],
}
